{
  "name": "${localWorkspaceFolderBasename}-csharp",
  "dockerComposeFile": [
    "../../docker-compose.yml"
  ],
  "service": "csharp",
  "workspaceFolder": "/${localWorkspaceFolderBasename}",
  "overrideCommand": true,
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  "shutdownAction": "none",
  "customizations": {
    "vscode": {
      "extensions": [
        "42crunch.vscode-openapi",
        "desmondhiew.singular-plural",
        "EditorConfig.EditorConfig",
        "george-alisson.html-preview-vscode",
        "inferrinizzard.prettier-sql-vscode",
        "kreativ-software.csharpextensions",
        "mechatroner.rainbow-csv",
        "ms-dotnettools.csdevkit",
        "ms-dotnettools.csharp",
        "ms-dotnettools.vscodeintellicode-csharp",
        "redhat.vscode-yaml",
        "tamasfe.even-better-toml",
        "wmaurer.change-case"
      ],
      "settings": {
        "[json]": {
          "editor.defaultFormatter": "vscode.json-language-features"
        },
        "[csharp]": {
          "editor.formatOnSave": true
        },
        "editor.find.loop": false,
        "workbench.colorCustomizations": {
          "titleBar.activeBackground": "#542442",
          "titleBar.activeForeground": "#FFF0FA",
          "titleBar.inactiveBackground": "#301827",
          "titleBar.inactiveForeground": "#C9A4BA",
          "editor.background": "#101214",
          "sideBar.background": "#1B151A",
          "activityBar.background": "#341B2B",
          "activityBar.activeBorder": "#E06AB3"
        }
      }
    }
  },
  "remoteUser": "dev"
}
