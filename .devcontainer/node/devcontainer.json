{
  "name": "${localWorkspaceFolderBasename}-node",
  "dockerComposeFile": ["../../docker-compose.yml"],
  "service": "node",
  "workspaceFolder": "/${localWorkspaceFolderBasename}",
  "overrideCommand": true,
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  "shutdownAction": "none",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "desmondhiew.singular-plural",
        "EditorConfig.EditorConfig",
        "esbenp.prettier-vscode",
        "george-alisson.html-preview-vscode",
        "mechatroner.rainbow-csv",
        "tamasfe.even-better-toml",
        "wmaurer.change-case"
      ],
      "settings": {
        "[javascript]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[javascriptreact]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[typescript]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[typescriptreact]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "editor.codeActionsOnSave": {
          "source.fixAll.eslint": "explicit"
        },
        "editor.formatOnSave": true,
        "eslint.validate": [
          "javascript",
          "javascriptreact",
          "typescript",
          "typescriptreact"
        ],
        "eslint.workingDirectories": [
          {
            "mode": "auto"
          }
        ],
        "js/ts.tsdk.path": "node_modules/typescript/lib",
        "prettier.configPath": "prettier.config.json",
        "workbench.colorCustomizations": {
          "titleBar.activeBackground": "#163D2D",
          "titleBar.activeForeground": "#F0FFF6",
          "titleBar.inactiveBackground": "#10241D",
          "titleBar.inactiveForeground": "#91B8A3",
          "editor.background": "#101214",
          "sideBar.background": "#141A17",
          "activityBar.background": "#10291F",
          "activityBar.activeBorder": "#339933"
        }
      }
    }
  },
  "remoteUser": "dev"
}
