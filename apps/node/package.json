{
  "name": "node",
  "version": "1.0.0",
  "packageManager": "yarn@4.18.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc --project ./tsconfig.json",
    "start": "node ./dist/index.js",
    "type:check": "tsc --project ./tsconfig.json --noEmit",
    "lint:check": "eslint ./src",
    "lint:fix": "eslint ./src --fix",
    "format:check": "prettier --check --config ./prettier.config.json \"src/**/*.{js,cjs,mjs,jsx,ts,cts,mts,tsx}\"",
    "format:fix": "prettier --write --config ./prettier.config.json \"src/**/*.{js,cjs,mjs,jsx,ts,cts,mts,tsx}\""
  },
  "prettier": "./prettier.config.json",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "24",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.3.0",
    "eslint-plugin-promise": "^7.3.0",
    "globals": "^17.0.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0"
  }
}
