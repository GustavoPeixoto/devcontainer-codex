{
  "plugins": ["@trivago/prettier-plugin-sort-imports"],
  "singleQuote": true,
  "jsxSingleQuote": true,
  "bracketSameLine": false,
  "semi": false,
  "tabWidth": 2,
  "bracketSpacing": true,
  "arrowParens": "always",
  "trailingComma": "all",
  "importOrder": [
    "^(?![\\\\.|~]).*$",
    "^@.*$",
    "^~.*$",
    "^(../).*$",
    "^(./).*$"
  ],
  "importOrderSeparation": true,
  "importOrderSortSpecifiers": true
}
